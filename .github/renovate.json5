// Repo overrides on top of the org preset (the bot's global config already applies
// github>bitwise-media-group/renovate-config:default.json5 to every repository).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // re-lists the preset's entries (an override replaces the array, not merges it),
  // plus: charts/*/vendor and charts/*/rendered are intentional vendored snapshots of
  // the upstream helm charts and their rendered manifests — never ours to modify, so
  // Renovate must not propose bumps inside them; they are output of the chart mirror
  // regeneration below, not input
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    ".mise/**",
    "charts/*/vendor/**",
    "charts/*/rendered/**",
  ],

  // ---------------------------------------------------------------------------------
  // Chart mirror updates. Renovate discovers new upstream versions and owns the PR
  // lifecycle (branches, rebases, verified commits, the dashboard); patchy rebuilds
  // everything derived from the moved pin in a post-upgrade task
  // (`patchy mirror upgrade --pinned <entry>`), refusing any pin outside its
  // versionConstraint or a lockstep group caught half-bumped. Both pins come straight
  // from the patchy entry schema (mirror.patchy.bitwisemedia.uk/v1alpha1):
  //   chart.version            — in charts/<entry>/manifest.yaml
  //   images.track[].valuesPath — in the entry's discovery values file
  // ---------------------------------------------------------------------------------
  customManagers: [
    // chart.version in every Chart entry manifest. OCI chart repos resolve through the
    // docker datasource (the route Renovate's own helm managers take for oci://);
    // classic repos through the helm index. helm versioning tolerates cert-manager's v
    // prefix. depType carries the entry's chart.lockstep group, so the grouping rule
    // below reads membership from the manifests instead of duplicating it here.
    {
      customType: "jsonata",
      fileFormat: "yaml",
      managerFilePatterns: ["charts/*/manifest.yaml"],
      matchStrings: [
        '$[kind = "Chart"].($oci := $substring(chart.repo, 0, 6) = "oci://"; {"depName": name, "depType": chart.lockstep ? "lockstep-" & chart.lockstep : "chart", "currentValue": chart.version, "datasource": $oci ? "docker" : "helm", "packageName": $oci ? $substringAfter(chart.repo, "oci://") & "/" & chart.name : chart.name, "registryUrl": $oci ? undefined : chart.repo})',
      ],
      versioningTemplate: "helm",
    },
    // tracked images (images.track[] in the manifest). The pin lives at the rule's
    // valuesPath in its values file — a separate file from the rule, which no custom
    // manager can join — so each pinned line carries a `# renovate:` annotation naming
    // the rule's image on the line directly above it. The value is either a full
    // `<repo>:<tag>` reference (optionally behind a YAML anchor) or a bare tag, matching
    // the two pin forms patchy splices. Images patchy cannot track — tags with a variant
    // suffix, like gha-runner-scale-set's `docker:<version>-dind` — use the same
    // annotation and are bumped by Renovate alone; docker versioning keeps the suffix.
    {
      customType: "regex",
      managerFilePatterns: ["/^charts/[^/]+/values/.+\\.ya?ml$/"],
      matchStrings: [
        "#\\s*renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*image: (?:&\\S+\\s+)?[\"']?\\S+:(?<currentValue>[^\\s\"'@]+)",
        "#\\s*renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*tag: [\"']?(?<currentValue>[^\\s\"'@]+)",
      ],
      depTypeTemplate: "tracked-image",
    },
  ],
  packageRules: [
    // Every chart-mirror update.
    {
      matchManagers: ["custom.jsonata", "custom.regex"],
      matchFileNames: ["charts/**"],
      // the allowlist is regenerated, so a human reviews every one: never Renovate's
      // unattended automerge (overrides the preset's stable minor/patch rule); the
      // auto-merge label hands the post-approval merge to the merge workflow instead
      automerge: false,
      addLabels: ["auto-merge"],
      // OCI registries (ghcr.io, quay.io, registry.k8s.io) expose no release
      // timestamps to the docker datasource, so under the default timestamp-required
      // the preset's 3-day stability check would stay pending forever. The preset's
      // minimumReleaseAge still applies wherever a timestamp exists (helm index
      // charts), standing in for patchy.yaml's mirror.update.cooldownDays.
      minimumReleaseAgeBehaviour: "timestamp-optional",
      // One branch per entry: a chart bump and its tracked-image bumps regenerate the
      // same images.lock.yaml / rendered/ / allowlist, so separate PRs would only
      // conflict with each other. Lockstep members regroup by group below.
      groupName: "{{{replace '^charts/([^/]+)/.*$' '$1' packageFile}}}",
      group: { commitMessageTopic: "{{{groupName}}} chart and images" },
      // keeps the release-please semantics of the `feat(<entry>): …` mirror commits
      semanticCommitType: "feat",
      semanticCommitScope: "{{{replace '^charts/([^/]+)/.*$' '$1' packageFile}}}",
      postUpgradeTasks: {
        // patchy and grype (the allowlist derivation's image scanner) up front: both
        // are lazy pins in the toolchain (.mise/config.toml) and their bootstrap shims
        // misfire under containerbase. Both commands must stay allowlisted in
        // renovate-config's renovate-global.json5 allowedCommands.
        commands: [
          "mise install github:bitwise-media-group/patchy aqua:anchore/grype",
          "mise exec -- patchy mirror upgrade --pinned {{{replace '^charts/([^/]+)/.*$' '$1' packageFile}}}",
        ],
        // the Renovate image ships no mise binary
        installTools: { mise: {} },
        // patchy writes only under the entry directory; anything else (mise.lock churn
        // from the install) is not part of the update
        fileFilters: ["charts/**"],
        // once per dependency: each one names its own entry, and every lockstep member
        // must regenerate. An entry whose chart and tracked image move together runs
        // twice; the second run converges to the same bytes.
        executionMode: "update",
      },
    },
    // Majors: every chart and track versionConstraint today is "stay in the current
    // major", and `--pinned` rejects any pin outside it regardless — this only keeps
    // doomed PRs from opening. Moving a major is a deliberate manifest edit
    // (versionConstraint + `make mirror-upgrade ENTRY=<name>`).
    {
      matchManagers: ["custom.jsonata", "custom.regex"],
      matchFileNames: ["charts/**"],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchManagers: ["custom.jsonata"],
      matchFileNames: ["charts/**"],
      commitMessageTopic: "{{depName}} chart",
    },
    {
      matchManagers: ["custom.regex"],
      matchDepTypes: ["tracked-image"],
      commitMessageTopic: "{{depName}} image",
    },
    // Lockstep groups (chart.lockstep in the manifests): every member's chart bump
    // lands in one PR. The members' tags normally publish together upstream; if
    // Renovate catches only one, `--pinned` fails the branch rather than shipping a
    // half-pair, and the next run picks up the partner.
    {
      matchManagers: ["custom.jsonata"],
      matchDepTypes: ["lockstep-*"],
      groupName: "{{{replace '^lockstep-' '' depType}}}",
      group: { commitMessageTopic: "{{{groupName}}} charts" },
      semanticCommitScope: "{{{replace '^lockstep-' '' depType}}}",
    },
  ],
}
