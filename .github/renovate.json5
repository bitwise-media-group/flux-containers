// Repo overrides on top of the org preset (the bot's global config already applies
// github>bitwise-media-group/renovate-config:default.json5 to every repository).
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // re-lists the preset's entries (an override replaces the array, not merges it),
  // plus: charts/*/vendor and charts/*/rendered are intentional vendored snapshots of
  // the upstream helm charts and their rendered manifests — never ours to modify, so
  // Renovate must not propose bumps inside them; they are output of the chart mirror
  // regen below, not input
  ignorePaths: [
    "**/node_modules/**",
    "**/bower_components/**",
    ".mise/**",
    "charts/*/vendor/**",
    "charts/*/rendered/**",
  ],
  // Chart mirror updates: Renovate discovers new upstream versions and owns the PR
  // lifecycle; patchy rebuilds everything derived from the new pin
  // (`patchy mirror upgrade --pinned`, see the postUpgradeTasks rule below).
  customManagers: [
    // chart.version in every entry manifest. OCI chart repos resolve through the docker
    // datasource (the same route Renovate's own helm managers take for oci://); classic
    // repos through the helm index. helm versioning tolerates cert-manager's v prefix.
    {
      customType: "jsonata",
      fileFormat: "yaml",
      managerFilePatterns: ["charts/*/manifest.yaml"],
      matchStrings: [
        '$[kind = "Chart"].($oci := $substring(chart.repo, 0, 6) = "oci://"; {"depName": name, "currentValue": chart.version, "datasource": $oci ? "docker" : "helm", "packageName": $oci ? $substringAfter(chart.repo, "oci://") & "/" & chart.name : chart.name, "registryUrl": $not($oci) ? chart.repo})',
      ],
      versioningTemplate: "helm",
    },
    // tracked images (images.track in the manifest): the pin lives in the entry's
    // discovery values, marked by a `# renovate:` annotation on the line above —
    // either a full `image: <repo>:<tag>` reference or a bare `tag: <tag>`.
    {
      customType: "regex",
      managerFilePatterns: ["charts/*/values/discovery.yaml"],
      matchStrings: [
        "#\\s*renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*image: \\S+:(?<currentValue>[^\\s\"']+)",
        "#\\s*renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*tag: [\"']?(?<currentValue>[^\\s\"']+)",
      ],
    },
  ],
  packageRules: [
    // Every chart-mirror update: majors disabled (every chart and track
    // versionConstraint today is "stay in the current major"; `--pinned` rejects any pin
    // outside the declared constraint regardless, so this only keeps doomed PRs from
    // opening), then patchy regenerates the derived state on the new pin.
    {
      matchManagers: ["custom.jsonata", "custom.regex"],
      matchFileNames: [
        "charts/*/manifest.yaml",
        "charts/*/values/discovery.yaml",
      ],
      matchUpdateTypes: ["major"],
      enabled: false,
    },
    {
      matchManagers: ["custom.jsonata", "custom.regex"],
      matchFileNames: [
        "charts/*/manifest.yaml",
        "charts/*/values/discovery.yaml",
      ],
      // the allowlist is regenerated, so a human reviews every one: never Renovate's
      // unattended automerge (overrides the preset's stable minor/patch rule); the
      // auto-merge label hands the post-approval squash to ff-merge instead
      automerge: false,
      addLabels: ["auto-merge"],
      // OCI registries (ghcr.io, quay.io) expose no release timestamps to the docker
      // datasource, so under the default timestamp-required the stability check would
      // stay pending forever; the cooldown still applies wherever a timestamp exists
      // (helm index charts). A lockstep pair caught half-published fails `--pinned`
      // until the partner tag lands.
      minimumReleaseAgeBehaviour: "timestamp-optional",
      // keeps the release-please semantics of the old `feat(<entry>): …` commits; the
      // entry name is the charts/<entry>/ directory of the edited file
      semanticCommitType: "feat",
      semanticCommitScope: "{{{replace '^charts/([^/]+)/.*$' '$1' packageFile}}}",
      postUpgradeTasks: {
        // patchy and grype (the allowlist derivation's image scanner) up front: grype is
        // lazy in the toolchain and its bootstrap shim misfires under containerbase.
        // Both commands must stay allowlisted in renovate-config's renovate-global.json5.
        commands: [
          "mise install github:bitwise-media-group/patchy aqua:anchore/grype",
          "mise exec -- patchy mirror upgrade --pinned {{{replace '^charts/([^/]+)/.*$' '$1' packageFile}}}",
        ],
        // the Renovate image ships no mise binary
        installTools: { mise: {} },
        // patchy writes only under the entry directory; anything else (mise.lock
        // churn from the install) is not part of the update
        fileFilters: ["charts/**"],
        // once per dependency: each one names its own entry, and a lockstep group
        // regenerates every member
        executionMode: "update",
      },
    },
    {
      matchManagers: ["custom.jsonata"],
      commitMessageTopic: "{{depName}} chart",
    },
    // lockstep groups — membership duplicates chart.lockstep in the manifests. The
    // members' tags normally land together upstream; if Renovate catches only one,
    // `--pinned` fails the branch rather than shipping a half-pair.
    {
      matchManagers: ["custom.jsonata"],
      matchDepNames: ["flux-operator", "flux-instance"],
      groupName: "flux",
      semanticCommitScope: "flux",
    },
    {
      matchManagers: ["custom.jsonata"],
      matchDepNames: [
        "gha-runner-scale-set",
        "gha-runner-scale-set-controller",
      ],
      groupName: "arc",
      semanticCommitScope: "arc",
    },
  ],
}
